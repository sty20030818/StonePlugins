{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": [
    "plugins/stonefish-engineering/src/**/*.mts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
